    {
      "name": "sc.user.connection.manage",
      "description": "Create, select, rename, delete, migrate, authorize, or sync one named provider connection with an explicit source/backend. Composio authorization persists only external IDs/status; no credential value or link_token is accepted or returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "action": {
            "type": "string",
            "enum": [
              "create",
              "set-default",
              "rename",
              "delete",
              "migrate-legacy",
              "authorize",
              "sync-external"
            ]
          },
          "connection": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "source": {
            "type": "string",
            "enum": [
              "sc",
              "composio",
              "native-mcp"
            ]
          },
          "authMethod": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "setDefault": {
            "type": "boolean"
          },
          "authConfigId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{2,128}$"
          },
          "brokerConnection": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "callbackUrl": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "user",
          "provider",
          "action",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.connection.manage"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.connection.request",
