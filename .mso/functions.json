{
  "version": 1,
  "functions": [
    {
      "name": "sc.product.interview",
      "description": "Decide whether a non-technical web-app idea is ready for a first build or return exactly one plain-language product question. Asks at most three questions before building and never asks for infrastructure choices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 4000
          },
          "primaryUser": {
            "type": "string",
            "maxLength": 1000
          },
          "primaryAction": {
            "type": "string",
            "maxLength": 2000
          },
          "mustHave": {
            "type": "string",
            "maxLength": 2000
          },
          "domain": {
            "type": "string",
            "maxLength": 253
          },
          "existingProject": {
            "type": "boolean"
          },
          "questionsAsked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "product.interview"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.deploy.plan",
      "description": "Turn a plain-language web-app goal into a simple user plan while internally choosing hosted, managed, or own-server execution. Includes optional technical diagnostics and never returns secret values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "string",
            "enum": [
              "auto",
              "hosted",
              "local"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "auto",
              "vps",
              "managed",
              "dokploy",
              "hybrid",
              "vercel"
            ]
          },
          "composioAvailable": {
            "type": "boolean"
          },
          "vpsAvailable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "deploy.plan"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.list",
      "description": "List SI-Coder users with default/current state, credential counts, provider summaries, and folder ownership. Never returns credential values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.list"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.show",
      "description": "Read one SI-Coder user, provider summary, mappings, and credential key names without credential values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.show"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.which",
      "description": "Resolve which SI-Coder user owns a directory, including default and explicit folder rules.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.which"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.create",
      "description": "Create an empty isolated SI-Coder user credential store. Does not accept credential values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.create"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.duplicate",
      "description": "Duplicate one user credential store into another independent user without returning values. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "replaceEmpty": {
            "type": "boolean"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "source",
          "target",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.duplicate"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.rename",
      "description": "Rename one SI-Coder user and migrate default/folder mappings. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "source",
          "target",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.rename"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.default",
      "description": "Set the default SI-Coder user. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "user",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.default"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.map",
      "description": "Map a directory tree to an explicit SI-Coder user. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "user",
          "path",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.map"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.unmap",
      "description": "Remove an explicit directory-to-user mapping. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "path",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.unmap"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.delete",
      "description": "Delete one SI-Coder user and its managed credential store/mappings without returning values. Explicit confirmation is required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "user",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.delete"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.providers.list",
      "description": "List provider readiness and credential status for one explicit SI-Coder user. Values are never returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.providers.list"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.provider.verify",
      "description": "Run live provider verification using only one explicit user credential store. Values are never returned.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.provider.verify"
      ],
      "timeoutMs": 30000
    },
    {
      "name": "sc.user.credentials.status",
      "description": "Read all or one provider credential status for one explicit SI-Coder user. Plaintext reads are impossible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.credentials.status"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.credential.status",
      "description": "Read one provider/key status for one explicit user, or provider-level status when key is omitted. Plaintext reads are impossible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          }
        },
        "required": [
          "user",
          "provider"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.credential.status"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.credential.request",
      "description": "Return a safe user-specific credential creation/rotation handoff. Never accepts a credential value; the user enters it only in hidden local terminal input or a connected secure action.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          }
        },
        "required": [
          "user",
          "provider"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.credential.request"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.credential.delete",
      "description": "Delete one key or all managed credentials for a provider from one explicit user. Never returns values and requires confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "user",
          "provider",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.credential.delete"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.providers.list",
      "description": "List si-coder built-in and custom provider metadata plus credential state/source. Secret values are never returned.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "providers.list"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.provider.create",
      "description": "Create a custom provider definition and its first env-key schema. This accepts metadata only, never a credential value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "title": {
            "type": "string"
          },
          "blurb": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "minLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "id",
          "key"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "provider.create"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.provider.update",
      "description": "Update title/blurb metadata for a custom provider. Built-in provider definitions are immutable.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "blurb": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "provider.update"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.provider.delete",
      "description": "Delete one custom provider and purge its managed credential keys from all si-coder profiles/managed bashrc. Requires explicit confirmation. Built-ins cannot be deleted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "confirmPurgeCredentials": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "confirmPurgeCredentials"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "provider.delete"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.provider.key-add",
      "description": "Add an env-key schema to a custom provider. Metadata only; does not accept or store a credential value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
          },
          "required": {
            "type": "boolean"
          },
          "public": {
            "type": "boolean"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "prefix": {
            "type": "string"
          },
          "minLength": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "id",
          "key"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "provider.key-add"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.provider.key-remove",
      "description": "Remove one env-key schema from a custom provider and purge that managed credential value. Requires explicit confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "confirmPurgeCredentials": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "id",
          "key",
          "confirmPurgeCredentials"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "provider.key-remove"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.secrets.status",
      "description": "Read credential status/source for all or one provider. Plaintext credential reads are deliberately impossible.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "secrets.status"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.secret.request",
      "description": "Return one simple user action for safely connecting a needed service, including the official link, where access is stored, what happens next, optional technical details, and [rekomendasi]. Never accepts a secret value.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "key": {
            "type": "string"
          }
        },
        "required": [
          "provider"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "secret.request"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.secret.delete",
      "description": "Delete one or all managed credential keys for a provider in the active si-coder store. Never returns secret values and requires explicit confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "provider",
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "secret.delete"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.doctor",
      "description": "Run live provider verification without printing credential values. Optionally restrict to named providers.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 50
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "doctor"
      ],
      "timeoutMs": 30000
    },
    {
      "name": "sc.update.check",
      "description": "Fetch and report whether the si-coder checkout is behind/ahead/diverged/dirty. Does not modify the checkout.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "update.check"
      ],
      "timeoutMs": 30000
    },
    {
      "name": "sc.update",
      "description": "Safely self-update si-coder by git fast-forward only. Refuses dirty, ahead, diverged, or detached checkouts. Requires explicit confirmation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "confirm": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "confirm"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "update.apply"
      ],
      "timeoutMs": 30000
    },
    {
      "name": "sc.version",
      "description": "Read the installed si-coder version, source checkout and git state.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "version"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.verify",
      "description": "Run the si-coder repository test suite without changing provider credentials.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "command": [
        "npm",
        "test"
      ],
      "timeoutMs": 30000
    }
  ]
}
