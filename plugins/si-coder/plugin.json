{
  "$schema": "urn:agent-plugin:manifest:v1",
  "schemaVersion": 1,
  "version": "0.9.8",
  "id": "si-coder",
  "metadata": {
    "name": "SI-Coder",
    "description": "Portable Agent Skills and MCP tools for building and publishing web applications.",
