{
  "version": 1,
  "functions": [
    {
      "name": "sc.product.interview",
      "description": "Decide whether a non-technical web-app idea is ready for a first build or return exactly one plain-language product question. Asks at most three questions before building and never asks for infrastructure choices.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 4000
          },
          "primaryUser": {
            "type": "string",
            "maxLength": 1000
          },
          "primaryAction": {
            "type": "string",
            "maxLength": 2000
          },
          "mustHave": {
            "type": "string",
            "maxLength": 2000
          },
          "domain": {
            "type": "string",
            "maxLength": 253
          },
          "existingProject": {
            "type": "boolean"
          },
          "questionsAsked": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "product.interview"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.deploy.plan",
      "description": "Turn a plain-language web-app goal into a simple user plan while internally choosing hosted, managed, or own-server execution. Includes optional technical diagnostics and never returns secret values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runtime": {
            "type": "string",
            "enum": [
              "auto",
              "hosted",
              "local"
            ]
          },
          "target": {
            "type": "string",
            "enum": [
              "auto",
              "vps",
              "managed",
              "dokploy",
              "hybrid",
              "vercel"
            ]
          },
          "composioAvailable": {
            "type": "boolean"
          },
          "vpsAvailable": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "deploy.plan"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.list",
      "description": "List SI-Coder users with default/current state, credential counts, provider summaries, and folder ownership. Never returns credential values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.list"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.show",
      "description": "Read one SI-Coder user, provider summary, mappings, and credential key names without credential values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.show"
      ],
      "timeoutMs": 10000
    },
    {
      "name": "sc.user.which",
