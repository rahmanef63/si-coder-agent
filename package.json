{
  "name": "si-coder-agent",
  "version": "0.8.7",
  "description": "Build and publish web apps from plain-language goals: SI-Coder hides infrastructure complexity, connects accounts safely, configures hosting/domain/data, and verifies the live app.",
  "keywords": [
    "claude-code",
    "claude-skills",
    "ai-agent",
    "agent-skills",
    "deployment-automation",
    "devops",
    "dokploy",
    "convex",
    "convex-self-hosted",
    "convex-cloud",
    "vercel",
    "hostinger",
    "nextjs",
    "zero-human",
    "self-hosted",
    "infrastructure-automation"
  ],
  "homepage": "https://github.com/rahmanef63/si-coder-agent#readme",
  "bugs": {
    "url": "https://github.com/rahmanef63/si-coder-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahmanef63/si-coder-agent.git"
  },
  "license": "MIT",
  "author": "Rahman EF",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "si-coder-onboard": "bin/onboard.js",
    "sc": "bin/sc.js"
  },
  "files": [
    "references/",
    ".mcp.json",
    ".claude-plugin/",
    ".mso/",
    "lib/",
    "scripts/",
    "skills/",
    "bin/",
    "SKILL.md",
    ".env.example",
    "install.sh",
    "README.md",
    "LICENSE",
    "AI_INSTALL.md",
    "dist/",
    ".agents/",
    "plugins/",
    "docs/",
    "OPENAI_SUBMISSION.md"
  ],
  "scripts": {
    "onboard": "node bin/onboard.js",
    "sc": "node bin/sc.js",
    "doctor": "node bin/sc.js doctor",
    "deploy": "node scripts/deploy.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "preversion": "npm test",
    "postversion": "git push --follow-tags origin main",
    "route": "node scripts/route-plan.js",
    "mcp": "node scripts/sc-mcp.js",
    "package:skills": "python3 scripts/package-web-skill.py",
    "docs:sync": "node scripts/sync-install-docs.js",
    "docs:check": "node scripts/sync-install-docs.js --check"
  }
}
