# Never commit real credentials. The tool invites a local .env
# (`cp .env.example .env`; rotate-admin-key.js can write ./.env; set-auth-env.js
# can emit a private-key .pem) — keep all of it out of git.
node_modules/
.env
.env.*
!.env.example
*.pem
*.key

# Python tooling cache
__pycache__/
*.pyc

# Local integration transfers are personal data, not repository source
*.integration-bundle.json
*.integration-bundle.enc.json
