    {
      "name": "sc.user.connections.list",
      "description": "List named provider connections for one SI-Coder user, including labels, source/backends, auth methods, scopes, defaults, safe external references/status, and credential key names without values.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "provider": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          }
        },
        "required": [
          "user"
        ],
        "additionalProperties": false
      },
      "command": [
        "node",
        "scripts/sc-agent.js",
        "user.connections.list"
      ],
      "timeoutMs": 10000
